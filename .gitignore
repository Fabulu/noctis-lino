# Build artifacts produced by the L.in.oleum compiler.
# Everything here is reproducible from source via lino_build.ps1.
work/*.exe
!work/vhgame.exe
work/*.bin
!work/STARMAP.BIN
!work/digimap2.bin
!work/GUIDE.BIN
work/errorlog.txt
work/smblsmap.txt
work/gamediag.txt
work/*.png
work/*.lin
work/*.wavebuild.txt
work/rc*-smoke*/
work/rc*-journey*/

# The stock library compiler outputs are reproducible. The extended compiler is
# versioned so a clean checkout can build and play immediately.
main/lib/gen/*.exe
!main/lib/gen/compiler114m.exe

# The compiler emits "<name>.txt .exe" if the argument string picks up a
# trailing space - see README, "Toolchain gotchas".
*.txt .exe

# Test harness outputs (oracle.bin / python.bin / lino.bin are regenerated)
noctis-harness/*.exe
noctis-harness/*.bin

# Regression suite scratch: every lino/C source under tests/gen is generated by
# a test on the spot, so only the generators are worth tracking.
tests/gen/
__pycache__/

# Backups and crash droppings
*.bak
*.stackdump

# pristine baseline copies (git is the real backup)
pristine/
tools/*.bin

# bootstrap intermediates
main/lib/gen/compiler114*.exe
!main/lib/gen/compiler114m.exe
main/lib/gen/compiler114n.txt

COMMITMSG.tmp

# Local saves, release builds, capture evidence, and media-player diagnostics.
# STARMAP.BIN and GUIDE.BIN are intentionally versioned original runtime assets
# used by clean checkouts and distributable bundles.
CURRENT.LIN
dist/
vlc-help.txt
vlc-log.txt

# stray copies of reference data pulled in by test sandboxes
work/hits.tsv
work/*.tmp
